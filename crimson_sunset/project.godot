; Engine configuration file.
; Crimson Sunset — вертикальный срез (Godot 4.x)
config_version=5

[application]
config/name="Crimson Sunset"
run/main_scene="res://main/Main.tscn"
config/features=PackedStringArray("4.2")

[autoload]
GameState="*res://systems/GameState.gd"
SaveManager="*res://systems/SaveManager.gd"
MissionManager="*res://systems/MissionManager.gd"
DialogueManager="*res://systems/DialogueManager.gd"
NewsSystem="*res://systems/NewsSystem.gd"
TimeSystem="*res://systems/TimeSystem.gd"
AudioDirector="*res://systems/AudioDirector.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

